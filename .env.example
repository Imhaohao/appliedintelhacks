# OpenAI — required (also set on the Convex deployment; see note below)
OPENAI_API_KEY=

# Convex (populated by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── Convex backend env (required for auctions) ─────────────────────────────
# Specialist bidding/execution runs in Convex actions, NOT inside Next.js.
# Values in .env.local are only seen by Next (MCP route, pages). For Convex,
# set the same keys on your dev deployment:
#   npx convex env set OPENAI_API_KEY 'sk-...'
# Or: Dashboard → your deployment → Settings → Environment Variables.

# Public host used by the MCP endpoint to return web_view_url back to callers
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Tigris (artifact storage + world-state + context layer) ────────────────
# Create bucket "agora-artifacts" in the Tigris dashboard first.
# Set these on Convex too: npx convex env set TIGRIS_ACCESS_KEY_ID '...'
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_ENDPOINT_URL=https://fly.storage.tigris.dev
TIGRIS_BUCKET=agora-artifacts

# ── rtrvr.ai (live parallel-browser web-intel specialist) ──────────────────
# Confirm exact auth scheme with rtrvr founders at the hackathon.
RTRVR_API_KEY=
RTRVR_MCP_ENDPOINT=https://mcp.rtrvr.ai/mcp

# ── Opsera (judge security gate — cash prize track) ────────────────────────
# Confirm MCP tool names and auth with Opsera team at the hackathon.
OPSERA_API_KEY=
OPSERA_MCP_ENDPOINT=https://mcp.opsera.io/mcp

# ── InsForge backend specialist ────────────────────────────────────────────
# Both headers required — the MCP uses project-scoped legacy auth:
#   X-Api-Key + X-Base-URL. Without both, insforge-backend declines loudly.
INSFORGE_API_KEY=
INSFORGE_API_BASE_URL=

# ── Agora A2A loopback ─────────────────────────────────────────────────────
AGORA_LOOPBACK_BASE=http://localhost:3000

# ── Optional specialist integrations (mocked if absent) ───────────────────
TENSORLAKE_API_KEY=
DEVIN_API_KEY=
DEVIN_ORG_ID=
V0_API_KEY=

# ── External A2A endpoints (specialists disabled when absent) ──────────────
TENSORLAKE_A2A_ENDPOINT=
TENSORLAKE_A2A_AGENT_CARD_URL=
DEVIN_A2A_ENDPOINT=
DEVIN_A2A_AGENT_CARD_URL=
CONVEX_A2A_ENDPOINT=
CONVEX_A2A_AGENT_CARD_URL=
